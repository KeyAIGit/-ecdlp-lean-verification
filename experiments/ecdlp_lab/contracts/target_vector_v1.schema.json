{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.example/schemas/ecdlp-lab/target_vector_v1.schema.json",
  "title": "ECDLP lab split target vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "contract_kind",
    "internal_classification",
    "framework_authorization_class",
    "hypothesis_id",
    "candidate_id",
    "authorization_id",
    "native_research_outcome",
    "route_effect",
    "retention_class",
    "retainable",
    "provenance",
    "target_vector_id",
    "branch",
    "public_payload",
    "private_payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "lab_engineering_fixture"},
    "contract_kind": {"const": "target_vector_v1"},
    "internal_classification": {"const": "engineering_only"},
    "framework_authorization_class": {"const": "fixture"},
    "hypothesis_id": {"type": "null"},
    "candidate_id": {"type": "null"},
    "authorization_id": {"type": "null"},
    "native_research_outcome": {"const": false},
    "route_effect": {"const": "none"},
    "retention_class": {"const": "engineering_only"},
    "retainable": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "target_vector_id": {"$ref": "#/$defs/sha256"},
    "branch": {"enum": ["public", "private_validator_only"]},
    "public_payload": {
      "oneOf": [
        {"$ref": "#/$defs/publicPayload"},
        {"type": "null"}
      ]
    },
    "private_payload": {
      "oneOf": [
        {"$ref": "#/$defs/privatePayload"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"branch": {"const": "public"}},
        "required": ["branch"]
      },
      "then": {
        "properties": {
          "public_payload": {"$ref": "#/$defs/publicPayload"},
          "private_payload": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "public_payload": {"type": "null"},
          "private_payload": {"$ref": "#/$defs/privatePayload"}
        }
      }
    },
    {"$ref": "#/$defs/retentionInvariant"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 4294967295},
        {"type": "integer", "minimum": 0, "maximum": 4294967295}
      ],
      "items": false
    },
    "scalarInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "conditioned_threat_model"],
      "properties": {
        "lower": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "upper": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "conditioned_threat_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "publicPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "curve_catalog_sha256",
        "curve_fixture_id",
        "curve_id",
        "field_bits",
        "field_p",
        "curve_a",
        "curve_b",
        "generator",
        "target",
        "subgroup_order",
        "subgroup_order_bits",
        "target_count",
        "public_scalar_interval"
      ],
      "properties": {
        "source_kind": {
          "enum": ["committed_lab_catalog", "read_only_legacy_catalog"]
        },
        "curve_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "curve_fixture_id": {"$ref": "#/$defs/identifier"},
        "curve_id": {"$ref": "#/$defs/identifier"},
        "field_bits": {"type": "integer", "minimum": 3, "maximum": 32},
        "field_p": {"type": "integer", "minimum": 5, "maximum": 4294967295},
        "curve_a": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "curve_b": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "generator": {"$ref": "#/$defs/point"},
        "target": {"$ref": "#/$defs/point"},
        "subgroup_order": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4294967295
        },
        "subgroup_order_bits": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "target_count": {"const": 1},
        "public_scalar_interval": {
          "oneOf": [
            {"$ref": "#/$defs/scalarInterval"},
            {"type": "null"}
          ]
        }
      }
    },
    "privatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_target_vector_sha256",
        "target_derivation_seed",
        "expected_scalar",
        "generation_receipt_sha256",
        "validator_use_only"
      ],
      "properties": {
        "public_target_vector_sha256": {"$ref": "#/$defs/sha256"},
        "target_derivation_seed": {"$ref": "#/$defs/sha256"},
        "expected_scalar": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "generation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "validator_use_only": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree_clean",
        "source_snapshot_sha256",
        "producer_dependency_sha256s",
        "validator_dependency_sha256s",
        "config_sha256",
        "diff_sha256"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/gitCommit"},
        "source_tree_clean": {"type": "boolean"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "producer_dependency_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "validator_dependency_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "config_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "diff_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "retentionInvariant": {
      "if": {
        "properties": {"retainable": {"const": true}},
        "required": ["retainable"]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "source_tree_clean": {"const": true},
              "diff_sha256": {"type": "null"}
            },
            "required": ["source_tree_clean", "diff_sha256"]
          }
        }
      }
    }
  }
}
