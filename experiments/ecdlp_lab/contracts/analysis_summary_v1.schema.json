{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.example/schemas/ecdlp-lab/analysis_summary_v1.schema.json",
  "title": "ECDLP lab deterministic analysis summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "contract_kind",
    "internal_classification",
    "framework_authorization_class",
    "hypothesis_id",
    "candidate_id",
    "authorization_id",
    "native_research_outcome",
    "route_effect",
    "retention_class",
    "retainable",
    "provenance",
    "analysis_id",
    "campaign_id",
    "input_validation_receipt_sha256s",
    "primary_scaling_variable",
    "primary_cost_unit",
    "success_targets_decimal",
    "comparisons",
    "model_fits",
    "warnings",
    "inference_status",
    "secp256k1_extrapolation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "lab_engineering_fixture"},
    "contract_kind": {"const": "analysis_summary_v1"},
    "internal_classification": {"const": "engineering_only"},
    "framework_authorization_class": {"const": "fixture"},
    "hypothesis_id": {"type": "null"},
    "candidate_id": {"type": "null"},
    "authorization_id": {"type": "null"},
    "native_research_outcome": {"const": false},
    "route_effect": {"const": "none"},
    "retention_class": {"const": "engineering_only"},
    "retainable": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "analysis_id": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/sha256"},
    "input_validation_receipt_sha256s": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "analysis_protocol_id": {"const": "equal_success_scaling_v1"},
    "analysis_policies": {"$ref": "#/$defs/analysisPolicies"},
    "primary_scaling_variable": {"const": "log2_subgroup_order"},
    "primary_cost_unit": {"const": "group_law_invocations"},
    "success_targets_decimal": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/probabilityDecimal"}
    },
    "comparisons": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison"}
    },
    "model_fits": {
      "type": "array",
      "items": {"$ref": "#/$defs/modelFit"}
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/warning"}
    },
    "inference_status": {"const": "insufficient_for_asymptotic_inference"},
    "secp256k1_extrapolation": {"const": false}
  },
  "allOf": [
    {"$ref": "#/$defs/retentionInvariant"},
    {
      "if": {"required": ["analysis_protocol_id"]},
      "then": {
        "required": ["analysis_policies"],
        "properties": {
          "success_targets_decimal": {
            "type": "array",
            "prefixItems": [
              {"const": "0.50"},
              {"const": "0.95"}
            ],
            "items": false
          },
          "comparisons": {
            "type": "array",
            "minItems": 2,
            "items": {"$ref": "#/$defs/equalSuccessComparison"}
          },
          "model_fits": {
            "type": "array",
            "minItems": 2,
            "items": {"$ref": "#/$defs/equalSuccessModelFit"}
          }
        }
      },
      "else": {
        "not": {"required": ["analysis_policies"]},
        "properties": {
          "comparisons": {
            "items": {"$ref": "#/$defs/noEqualSuccessComparisonFields"}
          },
          "model_fits": {
            "items": {"$ref": "#/$defs/noEqualSuccessModelFitFields"}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "methodId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "unsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"
    },
    "signedDecimal": {
      "type": "string",
      "pattern": "^(?!-0(?:\\.0+)?$)-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "probabilityDecimal": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "field_bits",
        "subgroup_order_bits",
        "target_count",
        "successes",
        "failures",
        "censored",
        "empirical_success_probability_decimal",
        "normalized_expected_group_operations_decimal",
        "median_online_group_operations_decimal",
        "offline_group_operations",
        "estimated_algorithmic_memory_bytes",
        "workers",
        "full_cost"
      ],
      "properties": {
        "method_id": {"$ref": "#/$defs/methodId"},
        "public_target_vector_sha256": {"$ref": "#/$defs/sha256"},
        "curve_fixture_id": {"$ref": "#/$defs/identifier"},
        "subgroup_order": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4294967295
        },
        "log2_subgroup_order_decimal": {"$ref": "#/$defs/unsignedDecimal"},
        "success_target_decimal": {
          "enum": ["0.50", "0.95"]
        },
        "trial_semantics": {
          "enum": ["deterministic_replicates_v1", "independent_seed_trials_v1"]
        },
        "seed_cluster_count": {"type": "integer", "minimum": 1},
        "algorithm_seed_set_sha256": {"$ref": "#/$defs/sha256"},
        "equal_success_status": {
          "enum": ["reached", "unreachable_within_budget"]
        },
        "equal_success_attempts": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "expected_attempts_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/positiveDecimal"},
            {"type": "null"}
          ]
        },
        "conservative_normalized_group_operations_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/unsignedDecimal"},
            {"type": "null"}
          ]
        },
        "optimistic_normalized_group_operations_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/unsignedDecimal"},
            {"type": "null"}
          ]
        },
        "equal_success_full_cost": {
          "oneOf": [
            {"$ref": "#/$defs/equalSuccessFullCost"},
            {"type": "null"}
          ]
        },
        "censoring_sensitivity": {"$ref": "#/$defs/censoringSensitivity"},
        "clustered_uncertainty": {"$ref": "#/$defs/clusteredUncertainty"},
        "field_bits": {"type": "integer", "minimum": 3, "maximum": 32},
        "subgroup_order_bits": {"type": "integer", "minimum": 2, "maximum": 32},
        "target_count": {"type": "integer", "minimum": 1},
        "successes": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "censored": {"type": "integer", "minimum": 0},
        "empirical_success_probability_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/probabilityDecimal"},
            {"type": "null"}
          ]
        },
        "normalized_expected_group_operations_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/unsignedDecimal"},
            {"type": "null"}
          ]
        },
        "median_online_group_operations_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/unsignedDecimal"},
            {"type": "null"}
          ]
        },
        "offline_group_operations": {"type": "integer", "minimum": 0},
        "estimated_algorithmic_memory_bytes": {"type": "integer", "minimum": 0},
        "workers": {"type": "integer", "minimum": 1},
        "full_cost": {"$ref": "#/$defs/fullCost"}
      }
    },
    "analysisPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success_estimation",
        "censoring",
        "unreachable",
        "uncertainty",
        "clustering",
        "residuals",
        "outliers",
        "cross_validation"
      ],
      "properties": {
        "success_estimation": {"const": "conservative_empirical_v1"},
        "censoring": {"const": "exclude_primary_fit_report_sensitivity_v1"},
        "unreachable": {"const": "null_cost_with_budget_bound_v1"},
        "uncertainty": {"const": "delete_one_cluster_envelope_v1"},
        "clustering": {"const": "curve_and_algorithm_seed_v1"},
        "residuals": {"const": "log2_cost_v1"},
        "outliers": {"const": "report_no_silent_drop_v1"},
        "cross_validation": {"const": "leave_one_distinct_size_out_v1"}
      }
    },
    "clusteredUncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "estimand",
        "unit",
        "status",
        "cluster_count",
        "unreachable_delete_one_count",
        "lower_decimal",
        "upper_decimal"
      ],
      "properties": {
        "method": {"const": "delete_one_cluster_envelope_v1"},
        "estimand": {
          "const": "mean_observed_uncensored_group_operations_v1"
        },
        "unit": {"const": "group_law_invocations"},
        "status": {"enum": ["computed", "unavailable"]},
        "cluster_count": {"type": "integer", "minimum": 1},
        "unreachable_delete_one_count": {"type": "integer", "minimum": 0},
        "lower_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/signedDecimal"},
            {"type": "null"}
          ]
        },
        "upper_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/signedDecimal"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "computed"}}
          },
          "then": {
            "properties": {
              "lower_decimal": {"$ref": "#/$defs/signedDecimal"},
              "upper_decimal": {"$ref": "#/$defs/signedDecimal"}
            }
          },
          "else": {
            "properties": {
              "lower_decimal": {"type": "null"},
              "upper_decimal": {"type": "null"}
            }
          }
        }
      ]
    },
    "censoringSensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "probability_decimal",
        "expected_attempts_decimal",
        "integer_attempts",
        "equal_success_status",
        "normalized_group_operations_decimal"
      ],
      "properties": {
        "policy_id": {"const": "censored_as_failures_v1"},
        "probability_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/probabilityDecimal"},
            {"type": "null"}
          ]
        },
        "expected_attempts_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/positiveDecimal"},
            {"type": "null"}
          ]
        },
        "integer_attempts": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "equal_success_status": {
          "enum": ["reached", "unreachable_within_budget"]
        },
        "normalized_group_operations_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/unsignedDecimal"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["equal_success_status"],
            "properties": {"equal_success_status": {"const": "reached"}}
          },
          "then": {
            "properties": {
              "probability_decimal": {"$ref": "#/$defs/probabilityDecimal"},
              "expected_attempts_decimal": {"$ref": "#/$defs/positiveDecimal"},
              "integer_attempts": {"type": "integer", "minimum": 1},
              "normalized_group_operations_decimal": {
                "$ref": "#/$defs/unsignedDecimal"
              }
            }
          },
          "else": {
            "properties": {
              "expected_attempts_decimal": {"type": "null"},
              "integer_attempts": {"type": "null"},
              "normalized_group_operations_decimal": {"type": "null"}
            }
          }
        }
      ]
    },
    "equalSuccessComparison": {
      "required": [
        "public_target_vector_sha256",
        "curve_fixture_id",
        "subgroup_order",
        "log2_subgroup_order_decimal",
        "success_target_decimal",
        "trial_semantics",
        "seed_cluster_count",
        "algorithm_seed_set_sha256",
        "equal_success_status",
        "equal_success_attempts",
        "expected_attempts_decimal",
        "conservative_normalized_group_operations_decimal",
        "optimistic_normalized_group_operations_decimal",
        "equal_success_full_cost",
        "censoring_sensitivity",
        "clustered_uncertainty"
      ],
      "allOf": [
        {
          "if": {
            "properties": {"equal_success_status": {"const": "reached"}},
            "required": ["equal_success_status"]
          },
          "then": {
            "properties": {
              "equal_success_attempts": {"type": "integer", "minimum": 1},
              "expected_attempts_decimal": {"$ref": "#/$defs/positiveDecimal"},
              "conservative_normalized_group_operations_decimal": {
                "$ref": "#/$defs/unsignedDecimal"
              },
              "optimistic_normalized_group_operations_decimal": {
                "$ref": "#/$defs/unsignedDecimal"
              },
              "equal_success_full_cost": {"$ref": "#/$defs/equalSuccessFullCost"},
              "normalized_expected_group_operations_decimal": {
                "$ref": "#/$defs/unsignedDecimal"
              },
              "full_cost": {"$ref": "#/$defs/equalSuccessFullCost"}
            }
          },
          "else": {
            "properties": {
              "equal_success_attempts": {"type": "null"},
              "expected_attempts_decimal": {"type": "null"},
              "conservative_normalized_group_operations_decimal": {
                "type": "null"
              },
              "optimistic_normalized_group_operations_decimal": {
                "type": "null"
              },
              "equal_success_full_cost": {"type": "null"}
              ,
              "normalized_expected_group_operations_decimal": {"type": "null"}
            }
          }
        }
      ]
    },
    "noEqualSuccessComparisonFields": {
      "allOf": [
        {"not": {"required": ["public_target_vector_sha256"]}},
        {"not": {"required": ["curve_fixture_id"]}},
        {"not": {"required": ["subgroup_order"]}},
        {"not": {"required": ["log2_subgroup_order_decimal"]}},
        {"not": {"required": ["success_target_decimal"]}},
        {"not": {"required": ["trial_semantics"]}},
        {"not": {"required": ["seed_cluster_count"]}},
        {"not": {"required": ["algorithm_seed_set_sha256"]}},
        {"not": {"required": ["equal_success_status"]}},
        {"not": {"required": ["equal_success_attempts"]}},
        {"not": {"required": ["expected_attempts_decimal"]}},
        {
          "not": {
            "required": ["conservative_normalized_group_operations_decimal"]
          }
        },
        {
          "not": {
            "required": ["optimistic_normalized_group_operations_decimal"]
          }
        },
        {"not": {"required": ["equal_success_full_cost"]}},
        {"not": {"required": ["censoring_sensitivity"]}},
        {"not": {"required": ["clustered_uncertainty"]}}
      ]
    },
    "fullCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "online_cpu_hours_decimal",
        "online_gpu_hours_decimal",
        "offline_cpu_hours_decimal",
        "offline_gpu_hours_decimal",
        "storage_gb_decimal",
        "money_usd_decimal",
        "implementation_hours_decimal",
        "reviewer_hours_decimal",
        "preprocessing_included_in_totals",
        "amortization_class",
        "amortization_target_count",
        "reusable_setup",
        "shared_setup_id"
      ],
      "properties": {
        "measurement_status": {
          "enum": ["measured_v1", "not_measured_v1"]
        },
        "online_cpu_hours_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "online_gpu_hours_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "offline_cpu_hours_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "offline_gpu_hours_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "storage_gb_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "money_usd_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "implementation_hours_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "reviewer_hours_decimal": {
          "oneOf": [{"$ref": "#/$defs/unsignedDecimal"}, {"type": "null"}]
        },
        "preprocessing_included_in_totals": {"const": true},
        "amortization_class": {
          "enum": ["none_single_target", "fixed_batch", "multi_target", "reusable_setup"]
        },
        "amortization_target_count": {"type": "integer", "minimum": 1},
        "reusable_setup": {"type": "boolean"},
        "shared_setup_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["measurement_status"],
            "properties": {"measurement_status": {"const": "not_measured_v1"}}
          },
          "then": {
            "properties": {
              "online_cpu_hours_decimal": {"type": "null"},
              "online_gpu_hours_decimal": {"type": "null"},
              "offline_cpu_hours_decimal": {"type": "null"},
              "offline_gpu_hours_decimal": {"type": "null"},
              "storage_gb_decimal": {"type": "null"},
              "money_usd_decimal": {"type": "null"},
              "implementation_hours_decimal": {"type": "null"},
              "reviewer_hours_decimal": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "online_cpu_hours_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "online_gpu_hours_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "offline_cpu_hours_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "offline_gpu_hours_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "storage_gb_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "money_usd_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "implementation_hours_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "reviewer_hours_decimal": {"$ref": "#/$defs/unsignedDecimal"}
            }
          }
        }
      ]
    },
    "equalSuccessFullCost": {
      "allOf": [
        {"$ref": "#/$defs/fullCost"},
        {"required": ["measurement_status"]}
      ]
    },
    "coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_decimal"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "value_decimal": {"$ref": "#/$defs/signedDecimal"}
      }
    },
    "modelFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "status", "coefficients", "warning_codes"],
      "properties": {
        "method_id": {"$ref": "#/$defs/methodId"},
        "success_target_decimal": {"enum": ["0.50", "0.95"]},
        "clustered_uncertainty": {"$ref": "#/$defs/clusteredUncertainty"},
        "residuals": {
          "type": "array",
          "items": {"$ref": "#/$defs/residual"}
        },
        "leave_one_size_out": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/leaveOneSizeOut"}
        },
        "candidate_model_evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/modelCandidateEvidence"}
        },
        "model_id": {
          "enum": [
            "log2_t_alpha_log2_n_beta_log2log2_n_v1",
            "constant_factor_v1",
            "model_undecided_v1"
          ]
        },
        "status": {"enum": ["fitted", "undecided", "insufficient_data"]},
        "coefficients": {
          "type": "array",
          "items": {"$ref": "#/$defs/coefficient"}
        },
        "warning_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "modelCandidateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "status",
        "observation_count",
        "parameter_count",
        "design_full_rank",
        "rss_decimal",
        "aicc_decimal",
        "delta_aicc_decimal",
        "invalid_reason"
      ],
      "properties": {
        "model_id": {
          "enum": [
            "constant_factor_v1",
            "log2_t_alpha_log2_n_beta_log2log2_n_v1"
          ]
        },
        "status": {"enum": ["valid", "invalid"]},
        "observation_count": {"type": "integer", "minimum": 0},
        "parameter_count": {"enum": [2, 4]},
        "design_full_rank": {"type": "boolean"},
        "rss_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/unsignedDecimal"},
            {"type": "null"}
          ]
        },
        "aicc_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/signedDecimal"},
            {"type": "null"}
          ]
        },
        "delta_aicc_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/unsignedDecimal"},
            {"type": "null"}
          ]
        },
        "invalid_reason": {
          "oneOf": [
            {
              "enum": [
                "insufficient_observations",
                "rank_deficient",
                "non_finite"
              ]
            },
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "valid"}}
          },
          "then": {
            "properties": {
              "design_full_rank": {"const": true},
              "rss_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "aicc_decimal": {"$ref": "#/$defs/signedDecimal"},
              "delta_aicc_decimal": {"$ref": "#/$defs/unsignedDecimal"},
              "invalid_reason": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "aicc_decimal": {"type": "null"},
              "delta_aicc_decimal": {"type": "null"}
            }
          }
        }
      ]
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curve_fixture_id",
        "field_bits",
        "subgroup_order",
        "algorithm_seed",
        "observed_log2_cost_decimal",
        "predicted_log2_cost_decimal",
        "residual_decimal"
      ],
      "properties": {
        "curve_fixture_id": {"$ref": "#/$defs/identifier"},
        "field_bits": {"type": "integer", "minimum": 3, "maximum": 32},
        "subgroup_order": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4294967295
        },
        "algorithm_seed": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "observed_log2_cost_decimal": {"$ref": "#/$defs/signedDecimal"},
        "predicted_log2_cost_decimal": {"$ref": "#/$defs/signedDecimal"},
        "residual_decimal": {"$ref": "#/$defs/signedDecimal"}
      }
    },
    "leaveOneSizeOut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omitted_field_bits",
        "omitted_subgroup_orders",
        "status",
        "alpha_decimal",
        "beta_decimal"
      ],
      "properties": {
        "omitted_field_bits": {
          "type": "integer",
          "minimum": 3,
          "maximum": 32
        },
        "omitted_subgroup_orders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4294967295
          }
        },
        "status": {"enum": ["fitted", "undecided", "insufficient_data"]},
        "alpha_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/signedDecimal"},
            {"type": "null"}
          ]
        },
        "beta_decimal": {
          "oneOf": [
            {"$ref": "#/$defs/signedDecimal"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "fitted"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "alpha_decimal": {"$ref": "#/$defs/signedDecimal"},
              "beta_decimal": {"$ref": "#/$defs/signedDecimal"}
            }
          },
          "else": {
            "properties": {
              "alpha_decimal": {"type": "null"},
              "beta_decimal": {"type": "null"}
            }
          }
        }
      ]
    },
    "equalSuccessModelFit": {
      "required": [
        "method_id",
        "success_target_decimal",
        "clustered_uncertainty",
        "residuals",
        "leave_one_size_out",
        "candidate_model_evidence"
      ]
    },
    "noEqualSuccessModelFitFields": {
      "allOf": [
        {"not": {"required": ["method_id"]}},
        {"not": {"required": ["success_target_decimal"]}},
        {"not": {"required": ["clustered_uncertainty"]}},
        {"not": {"required": ["residuals"]}},
        {"not": {"required": ["leave_one_size_out"]}},
        {"not": {"required": ["candidate_model_evidence"]}}
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree_clean",
        "source_snapshot_sha256",
        "producer_dependency_sha256s",
        "validator_dependency_sha256s",
        "config_sha256",
        "diff_sha256"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/gitCommit"},
        "source_tree_clean": {"type": "boolean"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "producer_dependency_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "validator_dependency_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "diff_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "retentionInvariant": {
      "if": {
        "properties": {"retainable": {"const": true}},
        "required": ["retainable"]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "source_tree_clean": {"const": true},
              "diff_sha256": {"type": "null"}
            },
            "required": ["source_tree_clean", "diff_sha256"]
          }
        }
      }
    }
  }
}
