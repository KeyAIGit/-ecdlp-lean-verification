{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.example/schemas/ecdlp-lab/telemetry_v1.schema.json",
  "title": "ECDLP lab observational telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "contract_kind",
    "internal_classification",
    "framework_authorization_class",
    "hypothesis_id",
    "candidate_id",
    "authorization_id",
    "native_research_outcome",
    "route_effect",
    "retention_class",
    "retainable",
    "provenance",
    "telemetry_id",
    "work_unit_id",
    "attempt_id",
    "semantic_digest_member",
    "observed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "lab_engineering_fixture"},
    "contract_kind": {"const": "telemetry_v1"},
    "internal_classification": {"const": "engineering_only"},
    "framework_authorization_class": {"const": "fixture"},
    "hypothesis_id": {"type": "null"},
    "candidate_id": {"type": "null"},
    "authorization_id": {"type": "null"},
    "native_research_outcome": {"const": false},
    "route_effect": {"const": "none"},
    "retention_class": {"const": "engineering_only"},
    "retainable": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "telemetry_id": {"$ref": "#/$defs/sha256"},
    "work_unit_id": {"$ref": "#/$defs/sha256"},
    "attempt_id": {"$ref": "#/$defs/sha256"},
    "semantic_digest_member": {"const": false},
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at_utc",
        "finished_at_utc",
        "wall_duration_ns",
        "cpu_time_ns",
        "peak_rss_bytes",
        "exit_code",
        "termination_signal",
        "platform",
        "architecture",
        "python_version",
        "tools"
      ],
      "properties": {
        "started_at_utc": {"$ref": "#/$defs/timestamp"},
        "finished_at_utc": {"$ref": "#/$defs/timestamp"},
        "wall_duration_ns": {"type": "integer", "minimum": 0},
        "cpu_time_ns": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 0},
        "exit_code": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 255},
            {"type": "null"}
          ]
        },
        "termination_signal": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "platform": {"type": "string", "minLength": 1, "maxLength": 256},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 64},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/toolVersion"}
        }
      }
    }
  },
  "allOf": [{"$ref": "#/$defs/retentionInvariant"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "toolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "capability_state"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "capability_state": {
          "enum": ["available", "unavailable", "error", "untested"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree_clean",
        "source_snapshot_sha256",
        "producer_dependency_sha256s",
        "validator_dependency_sha256s",
        "config_sha256",
        "diff_sha256"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/gitCommit"},
        "source_tree_clean": {"type": "boolean"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "producer_dependency_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "validator_dependency_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "diff_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "retentionInvariant": {
      "if": {
        "properties": {"retainable": {"const": true}},
        "required": ["retainable"]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "source_tree_clean": {"const": true},
              "diff_sha256": {"type": "null"}
            },
            "required": ["source_tree_clean", "diff_sha256"]
          }
        }
      }
    }
  }
}
