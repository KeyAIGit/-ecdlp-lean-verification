{
  "$id": "https://keyai.example/schemas/ecdlp-lab-artifact_ref-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_id": {
      "type": "null"
    },
    "candidate_id": {
      "type": "null"
    },
    "contract_kind": {
      "const": "artifact_ref"
    },
    "hypothesis_id": {
      "type": "null"
    },
    "native_research_outcome": {
      "const": false
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "pattern": "^[^/]+/[^/]+$",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_ref_id",
        "sha256",
        "size_bytes",
        "media_type",
        "role",
        "location"
      ],
      "type": "object"
    },
    "record_kind": {
      "const": "lab_engineering_fixture"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "retainable": {
      "type": "boolean"
    },
    "retention_class": {
      "const": "engineering_only"
    },
    "route_effect": {
      "const": "none"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "contract_kind",
    "hypothesis_id",
    "candidate_id",
    "authorization_id",
    "native_research_outcome",
    "route_effect",
    "retention_class",
    "retainable",
    "payload",
    "record_sha256"
  ],
  "title": "ECDLP lab artifact_ref engineering fixture",
  "type": "object"
}
