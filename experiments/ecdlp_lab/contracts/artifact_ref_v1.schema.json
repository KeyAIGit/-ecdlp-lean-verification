{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.example/schemas/ecdlp-lab/artifact_ref_v1.schema.json",
  "title": "ECDLP lab content-addressed artifact reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "contract_kind",
    "internal_classification",
    "framework_authorization_class",
    "hypothesis_id",
    "candidate_id",
    "authorization_id",
    "native_research_outcome",
    "route_effect",
    "retention_class",
    "retainable",
    "provenance",
    "artifact_id",
    "sha256",
    "size_bytes",
    "media_type",
    "role",
    "location",
    "source_kind",
    "content_addressed",
    "immutable",
    "semantic_digest_member",
    "producer_contract_kind"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "lab_engineering_fixture"},
    "contract_kind": {"const": "artifact_ref_v1"},
    "internal_classification": {"const": "engineering_only"},
    "framework_authorization_class": {"const": "fixture"},
    "hypothesis_id": {"type": "null"},
    "candidate_id": {"type": "null"},
    "authorization_id": {"type": "null"},
    "native_research_outcome": {"const": false},
    "route_effect": {"const": "none"},
    "retention_class": {"const": "engineering_only"},
    "retainable": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "artifact_id": {"$ref": "#/$defs/sha256"},
    "sha256": {"$ref": "#/$defs/sha256"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "role": {
      "enum": [
        "curve_catalog",
        "target_vector_public",
        "target_vector_private",
        "method_request",
        "method_result",
        "telemetry",
        "validation_receipt",
        "analysis_summary",
        "source_snapshot",
        "producer_dependency",
        "validator_dependency",
        "reusable_setup",
        "remote_bundle",
        "engineering_other"
      ]
    },
    "location": {
      "oneOf": [
        {"$ref": "#/$defs/relativePath"},
        {"type": "null"}
      ]
    },
    "source_kind": {
      "enum": ["committed_lab", "read_only_legacy", "generated_local"]
    },
    "content_addressed": {"const": true},
    "immutable": {"type": "boolean"},
    "semantic_digest_member": {"type": "boolean"},
    "producer_contract_kind": {
      "oneOf": [
        {
          "enum": [
            "campaign_config_v1",
            "target_vector_v1",
            "work_unit_v1",
            "method_request_v1",
            "method_result_v1",
            "telemetry_v1",
            "validation_receipt_v1",
            "analysis_summary_v1",
            "artifact_ref_v1"
          ]
        },
        {"type": "null"}
      ]
    }
  },
  "allOf": [{"$ref": "#/$defs/retentionInvariant"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._/-]*$",
      "not": {"pattern": "(^|/)\\.\\.(/|$)"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree_clean",
        "source_snapshot_sha256",
        "producer_dependency_sha256s",
        "validator_dependency_sha256s",
        "config_sha256",
        "diff_sha256"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/gitCommit"},
        "source_tree_clean": {"type": "boolean"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "producer_dependency_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "validator_dependency_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "config_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "diff_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "retentionInvariant": {
      "if": {
        "properties": {"retainable": {"const": true}},
        "required": ["retainable"]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "source_tree_clean": {"const": true},
              "diff_sha256": {"type": "null"}
            },
            "required": ["source_tree_clean", "diff_sha256"]
          }
        }
      }
    }
  }
}
