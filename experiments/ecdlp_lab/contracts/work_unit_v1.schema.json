{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.example/schemas/ecdlp-lab/work_unit_v1.schema.json",
  "title": "ECDLP lab expanded work unit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "contract_kind",
    "internal_classification",
    "framework_authorization_class",
    "hypothesis_id",
    "candidate_id",
    "authorization_id",
    "native_research_outcome",
    "route_effect",
    "retention_class",
    "retainable",
    "provenance",
    "work_unit_id",
    "campaign_id",
    "attempt_id",
    "retry_ordinal",
    "identity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "lab_engineering_fixture"},
    "contract_kind": {"const": "work_unit_v1"},
    "internal_classification": {"const": "engineering_only"},
    "framework_authorization_class": {"const": "fixture"},
    "hypothesis_id": {"type": "null"},
    "candidate_id": {"type": "null"},
    "authorization_id": {"type": "null"},
    "native_research_outcome": {"const": false},
    "route_effect": {"const": "none"},
    "retention_class": {"const": "engineering_only"},
    "retainable": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "work_unit_id": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/sha256"},
    "attempt_id": {"$ref": "#/$defs/sha256"},
    "retry_ordinal": {"type": "integer", "minimum": 0},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_config_sha256",
        "curve_catalog_sha256",
        "curve_fixture_id",
        "public_target_vector_sha256",
        "method_id",
        "algorithm_seed",
        "method_implementation_sha256",
        "validator_implementation_sha256",
        "budgets",
        "repetition_ordinal"
      ],
      "properties": {
        "campaign_config_sha256": {"$ref": "#/$defs/sha256"},
        "curve_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "curve_fixture_id": {"$ref": "#/$defs/identifier"},
        "public_target_vector_sha256": {"$ref": "#/$defs/sha256"},
        "method_id": {"$ref": "#/$defs/methodId"},
        "algorithm_seed": {"type": "integer", "minimum": 0},
        "method_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "validator_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "budgets": {"$ref": "#/$defs/budgets"},
        "repetition_ordinal": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [{"$ref": "#/$defs/retentionInvariant"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "methodId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_subgroup_order_bits",
        "max_field_bits",
        "max_group_law_invocations",
        "max_table_entries",
        "max_steps",
        "timeout_ns",
        "max_memory_bytes",
        "workers"
      ],
      "properties": {
        "max_subgroup_order_bits": {"const": 32},
        "max_field_bits": {"const": 32},
        "max_group_law_invocations": {"type": "integer", "minimum": 1},
        "max_table_entries": {"type": "integer", "minimum": 1},
        "max_steps": {"type": "integer", "minimum": 1},
        "timeout_ns": {"type": "integer", "minimum": 1},
        "max_memory_bytes": {"type": "integer", "minimum": 1},
        "workers": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree_clean",
        "source_snapshot_sha256",
        "producer_dependency_sha256s",
        "validator_dependency_sha256s",
        "config_sha256",
        "diff_sha256"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/gitCommit"},
        "source_tree_clean": {"type": "boolean"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "producer_dependency_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "validator_dependency_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "diff_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "retentionInvariant": {
      "if": {
        "properties": {"retainable": {"const": true}},
        "required": ["retainable"]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "source_tree_clean": {"const": true},
              "diff_sha256": {"type": "null"}
            },
            "required": ["source_tree_clean", "diff_sha256"]
          }
        }
      }
    }
  }
}
