    "near_period_sections": "chi(psi_(n+a)(Q)) and chi(psi_(n-a)(Q)), 1<=a<=4",
    "coordinate_factor": "chi(x(Q))",
    "products": "all distinct products of retained candidates of weight at most 4"
  },
