    "first_jet_field": "J_n([k]G)=(-1)^(k-1)*n^(1-k^2)*J_n(G)^(k^2)*psi_k(G)^(-n^2)",
    "first_jet_character": "chi(J_n([k]G))=b_G*a_G^(k-1)*rho_G(k)",
    "J_n": "D_omega psi_n=2*y*d(psi_n)/dx",
    "a_G": "chi(-n*J_n(G))=chi(phi_raw(G))",
