{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.example/schemas/research-engine-validator-request-v3.json",
  "title": "Research Engine sanitized validator replay request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "source_commit",
    "instance",
    "measurement_contract",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^RER-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "instance": {
      "$ref": "#/$defs/instance"
    },
    "measurement_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "value_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "const": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curve_id",
        "m",
        "factor_base_size",
        "presentation",
        "seed"
      ],
      "properties": {
        "curve_id": {
          "type": "string",
          "minLength": 1
        },
        "m": {
          "type": "integer",
          "minimum": 2
        },
        "factor_base_size": {
          "type": "integer",
          "minimum": 2
        },
        "presentation": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^inputs/artifact-[0-9]{3}(\\.[A-Za-z0-9]+)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
