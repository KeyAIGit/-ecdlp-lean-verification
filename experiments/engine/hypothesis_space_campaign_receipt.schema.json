{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.org/schemas/hypothesis-space-campaign-receipt-v1.json",
  "title": "Immutable hypothesis-space shard receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "campaign_id",
    "universe_id_sha256",
    "evaluation_id_sha256",
    "shard_index",
    "start_ordinal",
    "end_ordinal_exclusive",
    "previous_receipt_file_sha256",
    "range_merkle_root_sha256",
    "range_frontier",
    "first_leaf_sha256",
    "last_leaf_sha256",
    "aggregates",
    "physical_evaluations",
    "unique_evaluation_cells_added",
    "duplicate_evaluations",
    "elapsed_ns",
    "signatures_per_minute",
    "harness",
    "receipt_payload_sha256"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "counterMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonnegative"}}
  },
  "properties": {
    "schema_version": {"const": "1.0-receipt"},
    "record_kind": {"const": "finite_unique_coverage_shard"},
    "campaign_id": {"type": "string", "pattern": "^HSC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "universe_id_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_id_sha256": {"$ref": "#/$defs/sha256"},
    "shard_index": {"$ref": "#/$defs/nonnegative"},
    "start_ordinal": {"$ref": "#/$defs/nonnegative"},
    "end_ordinal_exclusive": {"$ref": "#/$defs/positive"},
    "previous_receipt_file_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "range_merkle_root_sha256": {"$ref": "#/$defs/sha256"},
    "range_frontier": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["height", "leaf_count", "sha256"],
        "properties": {
          "height": {"$ref": "#/$defs/nonnegative"},
          "leaf_count": {"$ref": "#/$defs/positive"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "first_leaf_sha256": {"$ref": "#/$defs/sha256"},
    "last_leaf_sha256": {"$ref": "#/$defs/sha256"},
    "aggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold", "warm", "type_counts", "mask_counts"],
      "properties": {
        "cold": {"$ref": "#/$defs/nonnegative"},
        "warm": {"$ref": "#/$defs/nonnegative"},
        "type_counts": {"$ref": "#/$defs/counterMap"},
        "mask_counts": {"$ref": "#/$defs/counterMap"}
      }
    },
    "physical_evaluations": {"$ref": "#/$defs/positive"},
    "unique_evaluation_cells_added": {"$ref": "#/$defs/positive"},
    "duplicate_evaluations": {"const": 0},
    "elapsed_ns": {"$ref": "#/$defs/positive"},
    "signatures_per_minute": {"$ref": "#/$defs/positive"},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "resolution_rule"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "resolution_rule": {"type": "string", "minLength": 1}
      }
    },
    "receipt_payload_sha256": {"$ref": "#/$defs/sha256"}
  }
}
