{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.org/schemas/hypothesis-review-v0.1.json",
  "title": "KeyAI adversarial hypothesis review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "proposal_id",
    "proposal_sha256",
    "reviewed_on",
    "reviewer_id",
    "reviewer_role",
    "source_independence",
    "reviewer_provenance",
    "verdict",
    "blocker_codes",
    "summary",
    "evidence_inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^HGR-[A-Z0-9][A-Z0-9-]{4,80}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^HGP-[A-Z0-9][A-Z0-9-]{4,80}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "enum": [
        "algebra",
        "cryptanalysis_skeptic",
        "prior_art",
        "cost_model",
        "validator_design"
      ]
    },
    "source_independence": {
      "enum": [
        "declared_independent",
        "shared_context",
        "unknown"
      ]
    },
    "reviewer_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version",
        "session_id",
        "prompt_sha256",
        "blind_to_other_reviews"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "blind_to_other_reviews": {
          "type": "boolean"
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "revise",
        "block"
      ]
    },
    "blocker_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
