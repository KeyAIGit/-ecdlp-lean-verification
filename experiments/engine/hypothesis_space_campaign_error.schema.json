{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.org/schemas/hypothesis-space-campaign-error-v1.json",
  "title": "Append-only hypothesis-space campaign error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "error_id",
    "campaign_id",
    "universe_id_sha256",
    "evaluation_id_sha256",
    "shard_index",
    "start_ordinal",
    "stage",
    "exception_class",
    "message_excerpt",
    "traceback_excerpt",
    "message_truncated",
    "traceback_truncated",
    "message_sha256",
    "traceback_sha256",
    "occurred_at_utc",
    "retryable",
    "retry_class",
    "disposition",
    "previous_error_file_sha256",
    "error_payload_sha256"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0}
  },
  "properties": {
    "schema_version": {"const": "1.0-error"},
    "record_kind": {"const": "hypothesis_space_campaign_error"},
    "error_id": {"type": "string", "pattern": "^HSC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}-ERR-[0-9]{4}$"},
    "campaign_id": {"type": "string", "pattern": "^HSC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "universe_id_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_id_sha256": {"$ref": "#/$defs/sha256"},
    "shard_index": {"$ref": "#/$defs/nonnegative"},
    "start_ordinal": {"$ref": "#/$defs/nonnegative"},
    "stage": {"type": "string", "minLength": 1},
    "exception_class": {"type": "string", "minLength": 1},
    "message_excerpt": {"type": "string"},
    "traceback_excerpt": {"type": "string"},
    "message_truncated": {"type": "boolean"},
    "traceback_truncated": {"type": "boolean"},
    "message_sha256": {"$ref": "#/$defs/sha256"},
    "traceback_sha256": {"$ref": "#/$defs/sha256"},
    "occurred_at_utc": {"type": "string", "format": "date-time"},
    "retryable": {"type": "boolean"},
    "retry_class": {"type": "string", "minLength": 1},
    "disposition": {"const": "retained_operational_failure"},
    "previous_error_file_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "error_payload_sha256": {"$ref": "#/$defs/sha256"}
  }
}
