{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.org/schemas/research-engine-v0.2/research-claim.json",
  "title": "KeyAI claim-level research state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "route_id",
    "research_question_id",
    "statement",
    "threat_model",
    "mechanism_variant_id",
    "scope",
    "claim_disposition",
    "supersedes",
    "reopening_conditions",
    "evidence_event_ids",
    "assurance"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-[A-Z0-9][A-Z0-9-]{4,100}$"
    },
    "route_id": {
      "type": "string",
      "pattern": "^R-[A-Z0-9][A-Z0-9-]+$"
    },
    "research_question_id": {
      "type": "string",
      "pattern": "^RQ-[A-Z0-9][A-Z0-9-]{4,100}$"
    },
    "statement": {
      "type": "string",
      "minLength": 20
    },
    "threat_model": {
      "const": "classical-single-target-plain"
    },
    "mechanism_variant_id": {
      "type": "string",
      "pattern": "^MV-[A-Z0-9][A-Z0-9-]{4,100}$"
    },
    "scope": {
      "type": "string",
      "minLength": 20
    },
    "claim_disposition": {
      "enum": [
        "confirmed",
        "falsified",
        "bounded_negative",
        "inconclusive",
        "inapplicable"
      ]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-[A-Z0-9][A-Z0-9-]{4,100}$"
      }
    },
    "reopening_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "evidence_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(CEV|REO)-[A-Z0-9][A-Z0-9-]{4,100}$"
      }
    },
    "assurance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "lean_kernel",
          "certificate_replayed",
          "independent_reproduction",
          "empirical_native",
          "historical_migration",
          "literature_only"
        ]
      }
    }
  }
}
