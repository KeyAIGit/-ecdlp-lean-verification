{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.example/schemas/research-engine-run-v1.json",
  "title": "Research Engine native run envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "source_commit",
    "candidate_policy_sha256",
    "preregistration_sha256",
    "candidate_run_manifest",
    "candidate_run_manifest_sha256",
    "executed_instances",
    "completion",
    "result_artifacts",
    "validation_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^RER-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preregistration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_run_manifest": {
      "type": "string",
      "minLength": 1
    },
    "candidate_run_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executed_instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "curve_id",
          "m",
          "factor_base_size",
          "presentation",
          "seed",
          "result_record",
          "result_sha256",
          "validation_record",
          "validation_sha256"
        ],
        "properties": {
          "curve_id": {
            "type": "string",
            "minLength": 1
          },
          "m": {
            "type": "integer",
            "minimum": 2
          },
          "factor_base_size": {
            "type": "integer",
            "minimum": 2
          },
          "presentation": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          },
          "result_record": {
            "type": "string",
            "minLength": 1
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "validation_record": {
            "type": "string",
            "minLength": 1
          },
          "validation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "stopped_early"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "validation_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationArtifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role",
        "validator_id",
        "independent",
        "decisive_claim"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "validator_id": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "decisive_claim": {
          "type": "boolean"
        }
      }
    }
  }
}
