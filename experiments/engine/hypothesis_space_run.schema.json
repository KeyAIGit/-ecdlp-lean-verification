{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyai.org/schemas/hypothesis-space-run-v1.json",
  "title": "Hypothesis-space screening run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "recorded_at_utc",
    "record_kind",
    "status",
    "harness",
    "subject",
    "screening_snapshot",
    "execution",
    "operational_diagnostics",
    "knowledge_effect",
    "previous_record_sha256",
    "record_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {
      "type": "string",
      "pattern": "^HSR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "sequence": {"type": "integer", "minimum": 1},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "record_kind": {"const": "deterministic_screening_benchmark"},
    "status": {"enum": ["completed", "failed"]},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "resolution_rule"],
      "properties": {
        "path": {"const": "scripts/hypothesis_space_run_ledger.py"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "resolution_rule": {
          "const": "current checkout or reachable Git history contains matching path bytes"
        }
      }
    },
    "subject": {"$ref": "#/$defs/subject"},
    "screening_snapshot": {"type": ["object", "null"]},
    "execution": {"type": "object"},
    "operational_diagnostics": {"$ref": "#/$defs/diagnostics"},
    "knowledge_effect": {"$ref": "#/$defs/knowledgeEffect"},
    "previous_record_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "record_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {
        "properties": {
          "screening_snapshot": {"$ref": "#/$defs/screeningSnapshot"},
          "execution": {"$ref": "#/$defs/completedExecution"},
          "operational_diagnostics": {
            "properties": {
              "pipeline_errors": {"const": 0},
              "invariant_violations": {"const": 0},
              "error_classes": {"maxItems": 0}
            }
          }
        }
      },
      "else": {
        "properties": {
          "screening_snapshot": {"type": "null"},
          "execution": {"$ref": "#/$defs/failedExecution"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1Commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nonnegativeIntegerMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "space_id",
        "source_paths_sha256",
        "source_bindings",
        "instance_root_sha256",
        "coverage_merkle_root_sha256",
        "attempts"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/sha1Commit"},
        "space_id": {"type": "string", "minLength": 1},
        "source_paths_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "map_path",
            "runner_path",
            "shared_funnel_path",
            "space_policy_path",
            "state_path"
          ],
          "properties": {
            "map_path": {"$ref": "#/$defs/sha256"},
            "runner_path": {"$ref": "#/$defs/sha256"},
            "shared_funnel_path": {"$ref": "#/$defs/sha256"},
            "space_policy_path": {"$ref": "#/$defs/sha256"},
            "state_path": {"$ref": "#/$defs/sha256"}
          }
        },
        "source_bindings": {"type": "object"},
        "instance_root_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_merkle_root_sha256": {"$ref": "#/$defs/sha256"},
        "attempts": {"type": "integer", "minimum": 1}
      }
    },
    "screeningSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "counts_by_type",
        "challenge_coverage",
        "rejection_histogram",
        "primary_rejection_histogram",
        "warning_histogram",
        "review_queue_seed_ids"
      ],
      "properties": {
        "counts": {"$ref": "#/$defs/nonnegativeIntegerMap"},
        "counts_by_type": {"$ref": "#/$defs/nonnegativeIntegerMap"},
        "challenge_coverage": {"type": "object"},
        "rejection_histogram": {"$ref": "#/$defs/nonnegativeIntegerMap"},
        "primary_rejection_histogram": {"$ref": "#/$defs/nonnegativeIntegerMap"},
        "warning_histogram": {"$ref": "#/$defs/nonnegativeIntegerMap"},
        "review_queue_seed_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "python_implementation",
        "platform_system",
        "platform_machine",
        "logical_cpu_count"
      ],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1},
        "platform_system": {"type": "string", "minLength": 1},
        "platform_machine": {"type": "string", "minLength": 1},
        "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "commonExecutionProperties": {
      "type": "object",
      "properties": {
        "method": {"const": "in_process_run_space_core_plus_output_equality_v1"},
        "warmup_repetitions": {"type": "integer", "minimum": 1},
        "measured_repetitions": {"type": "integer", "minimum": 0},
        "elapsed_ns": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "timing_scope": {
          "const": "run_space core plus exact output equality check; excludes process startup and JSON rendering"
        },
        "canonical_argv": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"type": "string"}
        },
        "subject_files_match_source_commit": {"const": true},
        "environment": {"$ref": "#/$defs/environment"}
      }
    },
    "completedExecution": {
      "allOf": [
        {"$ref": "#/$defs/commonExecutionProperties"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "warmup_repetitions",
            "measured_repetitions",
            "elapsed_ns",
            "signatures_per_minute",
            "performance_summary",
            "target_signatures_per_minute",
            "performance_target_status",
            "timing_scope",
            "canonical_argv",
            "subject_files_match_source_commit",
            "environment"
          ],
          "properties": {
            "method": {},
            "warmup_repetitions": {},
            "measured_repetitions": {"type": "integer", "minimum": 1},
            "elapsed_ns": {},
            "signatures_per_minute": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1}
            },
            "performance_summary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum_signatures_per_minute",
                "median_signatures_per_minute",
                "maximum_signatures_per_minute"
              ],
              "properties": {
                "minimum_signatures_per_minute": {"type": "integer", "minimum": 1},
                "median_signatures_per_minute": {"type": "integer", "minimum": 1},
                "maximum_signatures_per_minute": {"type": "integer", "minimum": 1}
              }
            },
            "target_signatures_per_minute": {"type": "integer", "minimum": 1},
            "performance_target_status": {"enum": ["target_met", "target_not_met"]},
            "timing_scope": {},
            "canonical_argv": {},
            "subject_files_match_source_commit": {},
            "environment": {}
          }
        }
      ]
    },
    "failedExecution": {
      "allOf": [
        {"$ref": "#/$defs/commonExecutionProperties"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "warmup_repetitions",
            "measured_repetitions",
            "elapsed_ns",
            "timing_scope",
            "canonical_argv",
            "subject_files_match_source_commit",
            "environment"
          ],
          "properties": {
            "method": {},
            "warmup_repetitions": {},
            "measured_repetitions": {},
            "elapsed_ns": {},
            "timing_scope": {},
            "canonical_argv": {},
            "subject_files_match_source_commit": {},
            "environment": {}
          }
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_errors", "invariant_violations", "error_classes"],
      "properties": {
        "pipeline_errors": {"type": "integer", "minimum": 0},
        "invariant_violations": {"type": "integer", "minimum": 0},
        "error_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "knowledgeEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_outcome",
        "claim_disposition",
        "ranker_training_eligible",
        "brier_calibration_eligible",
        "candidate_admissible",
        "candidate_recommended",
        "experiment_authorized",
        "route_promotion",
        "evidence_class",
        "operational_calibration_scope",
        "scientific_exclusion_reasons",
        "interpretation"
      ],
      "properties": {
        "scientific_outcome": {"const": "none"},
        "claim_disposition": {"const": "none"},
        "ranker_training_eligible": {"const": false},
        "brier_calibration_eligible": {"const": false},
        "candidate_admissible": {"const": false},
        "candidate_recommended": {"const": false},
        "experiment_authorized": {"const": false},
        "route_promotion": {"const": false},
        "evidence_class": {"const": "operational"},
        "operational_calibration_scope": {"const": "throughput_only"},
        "scientific_exclusion_reasons": {
          "const": ["deterministic_hard_gate", "nonexperimental_benchmark"]
        },
        "interpretation": {"type": "string", "minLength": 1}
      }
    }
  }
}
